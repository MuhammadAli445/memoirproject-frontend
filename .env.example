# --- Database Settings ---
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
DIRECT_URL="postgresql://user:password@localhost:5432/dbname"

# --- Security / JWT Configuration ---
JWT_SECRET_KEY="your-secret-jwt-key-at-least-32-chars-long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth Credentials ---
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"

# --- File Storage (Local or AWS S3) ---
STORAGE_BACKEND="local" # "local" or "s3"
STORAGE_DIR="uploads"
STORAGE_SIGNING_SECRET="your-storage-hmac-signing-secret-key"
STORAGE_URL_EXPIRE_SECONDS=3600

# --- AWS S3 (Required if STORAGE_BACKEND=s3) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# --- Speech-to-Text (Whisper / AssemblyAI) ---
OPENAI_API_KEY=""
ASSEMBLYAI_API_KEY=""

# --- Stripe Payments ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET=""
FLAT_RATE_PRICE_USD=299.00
